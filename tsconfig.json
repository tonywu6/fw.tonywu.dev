{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "composite": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "~/*": ["./app/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client", "node"]
  },
  "include": [
    ".react-router/types/**/*",
    "eslint.config.js",
    "lingui.config.js",
    "react-router.config.ts",
    "vite.config.ts",
    "app/**/*",
    "app/**/.server.ts",
    "app/**/.server.tsx",
    "app/**/.server/**/*",
    "app/**/.client.ts",
    "app/**/.client.tsx",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "util"
  ]
}
